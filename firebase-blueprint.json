          "type": "boolean"
        },
        "profileVisibility": {
          "type": "string",
          "enum": ["public_guides", "initials_only", "private"]
        },
        "shareLocationConsent": {
          "type": "boolean"
        },
        "aiContextPersonalization": {
          "type": "boolean"
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["English", "Afrikaans", "isiXhosa"]
        },
