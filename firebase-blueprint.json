      "title": "UserProfile",
      "description": "Publicly minimal user profile and RBAC role record for CapeSafe Connect 360.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["tourist", "admin", "provider", "safety"]
        },
        "requestedRole": {
          "type": "string",
          "enum": ["tourist", "admin", "provider", "safety"]
        },
        "organization": {
          "type": "string",
          "maxLength": 140
